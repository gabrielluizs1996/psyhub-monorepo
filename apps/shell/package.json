{
  "name": "shell",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "shell",
    "targets": {
      "serve": {
        "options": {
          "port": 4200
        },
        "configurations": {
          "development": {
            "devRemotes": [
              "shop",
              "cart"
            ]
          }
        },
        "dependsOn": [
          "typecheck"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "typecheck"
        ]
      }
    }
  },
  "devDependencies": {
    "shop": "*",
    "cart": "*",
    "auth": "*"
  }
}
